MOMENT_ONE_ENV=development
MOMENT_ONE_DEBUG=true
MOMENT_ONE_LOG_LEVEL=INFO
MOMENT_ONE_API_PREFIX=/v1
MOMENT_ONE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL started by compose.yaml.
# These POSTGRES_* values initialize the container; MOMENT_ONE_DATABASE_URL is
# used when the API or Alembic runs directly on the host.
POSTGRES_DB=moment_one_dev
POSTGRES_USER=moment_one
POSTGRES_PASSWORD=moment-one-local-only
POSTGRES_PORT=5432
MOMENT_ONE_DATABASE_URL=postgresql+psycopg://moment_one:moment-one-local-only@127.0.0.1:5432/moment_one_dev
MOMENT_ONE_DATABASE_POOL_SIZE=5
MOMENT_ONE_DATABASE_MAX_OVERFLOW=5

# Remote Casdoor OIDC. Put real values only in the ignored .env file or CI/CD secrets.
MOMENT_ONE_CASDOOR_ISSUER=https://auth.example.com
MOMENT_ONE_CASDOOR_AUDIENCE=moment-one-api
MOMENT_ONE_CASDOOR_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# 眼镜端 JWT 自签发（QR Binding 授权）。生成密钥：
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# 生产环境通过 MOMENT_ONE_JWT_PRIVATE_KEY_PATH / MOMENT_ONE_JWT_PUBLIC_KEY_PATH 指定路径。
MOMENT_ONE_JWT_ISSUER=https://moment-one-api.yuanshuai.fun
MOMENT_ONE_JWT_AUDIENCE=moment-one-api
MOMENT_ONE_ACCESS_TOKEN_TTL_SECONDS=3600
MOMENT_ONE_REFRESH_TOKEN_TTL_SECONDS=7776000
MOMENT_ONE_BINDING_CODE_TTL_SECONDS=300
MOMENT_ONE_BINDING_CODE_LENGTH=24

# Remote MinIO / S3-compatible storage. Put real credentials only in .env or CI/CD secrets.
MOMENT_ONE_S3_ENDPOINT_URL=https://storage.example.com
MOMENT_ONE_S3_REGION=us-east-1
MOMENT_ONE_S3_BUCKET=moment-one-media
MOMENT_ONE_S3_ACCESS_KEY=change-me
MOMENT_ONE_S3_SECRET_KEY=change-me
MOMENT_ONE_S3_UPLOAD_URL_TTL_SECONDS=600
MOMENT_ONE_S3_DOWNLOAD_URL_TTL_SECONDS=300
MOMENT_ONE_MAX_UPLOAD_BYTES=20971520

# ---- MCP Server / MCP Apps ----
# MCP 对外暴露的基础 URL（发现端点、OAuth 回调都基于它拼绝对地址）
MOMENT_ONE_MCP_BASE_URL=http://127.0.0.1:8000
# MCP 工具可用 Scope（逗号分隔）
MOMENT_ONE_MCP_SCOPES_SUPPORTED=moments.read,moments.write,moments.delete
# Casdoor MCP OAuth 代理客户端（预注册的 Casdoor 应用，confidential client）
MOMENT_ONE_CASDOOR_MCP_CLIENT_ID=change-me
MOMENT_ONE_CASDOOR_MCP_CLIENT_SECRET=change-me
MOMENT_ONE_CASDOOR_MCP_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
# MCP OAuth 授权码有效期（秒）
MOMENT_ONE_MCP_AUTH_CODE_TTL_SECONDS=600
# MCP Apps UI 单文件产物（bookkeeping.html），相对仓库根
MOMENT_ONE_MCP_APPS_HTML_PATH=mcp_apps/bookkeeping/dist/bookkeeping.html

# ---- Account Center / Casdoor Management API ----
# 第三方账号绑定需要读取 MomentOne 应用的 Provider 配置，并在回调后核验绑定结果。
# 生产环境必须显式配置；本地若省略则会复用 CASDOOR_MCP_CLIENT_* confidential client。
# 使用独立管理应用时，仅授予 Server 读取用户和应用配置所需权限。
# 用户自助资料、密码、会话和第三方解绑仍应使用用户自己的 access token。
MOMENT_ONE_CASDOOR_MANAGEMENT_CLIENT_ID=
MOMENT_ONE_CASDOOR_MANAGEMENT_CLIENT_SECRET=
# 身份租户契约（Casdoor 启用时三项必填，并须与 Web 的公开配置一致）。
# 非该组织、或不是由该应用创建的用户会被拒绝访问。
MOMENT_ONE_CASDOOR_ORGANIZATION=example.org
MOMENT_ONE_CASDOOR_APPLICATION=moment-one
# Casdoor 应用实体 ID（应用 owner/name；应用 owner 不一定等于用户组织）。
MOMENT_ONE_CASDOOR_APPLICATION_ID=admin/moment-one
# 默认复用已注册的 MOMENT_ONE_CASDOOR_MCP_REDIRECT_URI (/oauth/callback)。
MOMENT_ONE_ACCOUNT_LINK_REDIRECT_URI=
MOMENT_ONE_WEB_BASE_URL=http://localhost:3000

# ---- PWA Web Push ----
# Generate a VAPID P-256 key pair with a Web Push compatible tool/library.
MOMENT_ONE_WEB_PUSH_ENABLED=false
MOMENT_ONE_WEB_PUSH_VAPID_PUBLIC_KEY=
MOMENT_ONE_WEB_PUSH_VAPID_PRIVATE_KEY=
MOMENT_ONE_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOMENT_ONE_WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# Notification worker（Reminder/Outbox/站内通知/Web Push 投递）
MOMENT_ONE_NOTIFICATION_WORKER_ENABLED=false
MOMENT_ONE_NOTIFICATION_POLL_INTERVAL_SECONDS=5
MOMENT_ONE_NOTIFICATION_BATCH_SIZE=50
MOMENT_ONE_NOTIFICATION_WORKER_ID=api-worker
MOMENT_ONE_WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,push.apple.com
